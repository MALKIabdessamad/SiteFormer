# Copy to .env for local development (.env is git-ignored; never commit real values).
# On Railway, add the same names under the service's Variables.

# ---- Public (inlined into the browser bundle at BUILD time) ----
# Optional: both default to the SiteFormer Supabase project (src/config/env.ts).
VITE_SUPABASE_URL=https://wuqraxscnshbivgjjyee.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_94JZqrmRmSFdn8oCyLb4mw_UWRZJn5Z

# ---- Server-only secrets (no VITE_ prefix, so they never reach the browser) ----
# Supabase → Project Settings → API Keys → Secret key (sb_secret_…) or legacy service_role.
SUPABASE_SECRET_KEY=
# Agent37 → API keys (sk_live_…). Creates and runs the users' sandboxes.
AGENT37_API_KEY=
# OpenRouter → Keys (sk-or-v1-…). Names new projects (and later runs the AI agent).
OPENROUTER_API_KEY=

# ---- Optional ----
# NAMING_MODEL=google/gemini-2.5-flash-lite
# NAMING_FALLBACK_MODELS=openai/gpt-4.1-nano,mistralai/mistral-small-3.2-24b-instruct
# AGENT37_TEMPLATE=agent37-base
# STARTER_REPO=https://github.com/MALKIabdessamad/app
# STARTER_REF=main
# STARTER_PORT=8080
# MAX_PROJECTS_PER_USER=20
# AGENT_MODEL=z-ai/glm-5.3-flash
# AGENT_REASONING=medium        # off | low | medium | high
# AGENT_MAX_STEPS=150           # model turns per run (safety cap; no time limit)
# AGENT_CONTEXT_TOKENS=90000    # compaction threshold
